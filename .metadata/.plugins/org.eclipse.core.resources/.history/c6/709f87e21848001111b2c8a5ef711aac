package com.amanda.curso.aula15;

import java.util.Iterator;
import java.util.Scanner;

public class JogoDaVelha {

	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);
		char jogadorAtual = 'X';
		boolean jogoAtivo = true;
		
		char[][] tabuleiro = {
	            {' ', ' ', ' '},
	            {' ', ' ', ' '},
	            {' ', ' ', ' '}
	        };
		
		while(jogoAtivo) {
			exibirTabuleiro(tabuleiro);
			System.out.println("Jogador " + jogadorAtual + 
					", escolha linha (0-2) e coluna (0-2): ");			
			int linha = scanner.nextInt();
			int coluna = scanner.nextInt();
			
			if (linha >= 0 
					&& linha < 3 
					&& coluna >= 0 
					&& coluna < 3 
					&& tabuleiro[linha][coluna] == ' ') {
				tabuleiro[linha][coluna] = jogadorAtual;
				
				verificarVencedor(tabuleiro,jogadorAtual);
					
				
			
			}
			
			//exibirTabuleiro(tabuleiro);
			jogoAtivo = false;
		};
		
		

	}
	
	public static void exibirTabuleiro(char[][] tabuleiro) {
		for (int i = 0; i < tabuleiro.length; i++) {
			System.out.println(tabuleiro[i][0]);
		}
	};
	public static boolean verificarVencedor(
			char[][] t, char j) {
		 for (int i = 0; i < t.length; i++) {
			if(
					t[i][0] == j 
					&& t[i][1] == j 
					&& t[i][2] == j
					||
					t[0][i] == j 
					&& t[1][i] == j 
					&& t[2][i] == j					
					) {
				System.out.println("certo");
			}
			
		}
		return true;
	}

}
