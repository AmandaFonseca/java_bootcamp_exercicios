package com.amanda.cursojava.aula13;

public class operadores {

	public static void main(String[] args) {
		int resultado = 1 + 1 ;
		System.out.println(resultado++);
        /*Pós-incremento (resultado++)
			Quando você usa resultado++ dentro de um System.out.println, 
			o Java segue esta ordem:
			-Primeiro: O valor atual da variável é enviado para o console.
			-Depois: A variável é incrementada em +1 na memória.
			Exemplo: Se resultado vale 2, ele imprime 2 e depois muda para 4.*/

        System.out.println(++resultado);
        /*Quando o operador vem antes, a ordem inverte:
		-Primeiro: A variável é incrementada em +1 imediatamente.
		-Depois: O novo valor é enviado para o console.
		 Exemplo: Se resultado vale 6, ele muda para 7 e imprime 7.*/
        
        System.out.println(resultado--);
        System.out.println(--resultado);
    
        
        int valor1 = 5;
        int valor2 = 3;
        
        boolean teste = (valor1 == 5) && (valor2 == 3);
        System.out.println("Valor1 é igual a 5 e valor2 é igual a 3");
        



	}

}
