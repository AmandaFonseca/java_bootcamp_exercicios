package com.amanda.cursojava.aula15.copy;
public abstract class Relogio {
    protected int hora;
    protected int minuto;
    protected int segundo;

    public int getHora() {
        return hora;
    }

    public int getMinuto() {
        return minuto;
    }

    public int getSegundo() {
        return segundo;
    }

    public void setHora(int hora) {
        if (hora < 0 || hora > 23)
            throw new IllegalArgumentException("Hora inválida");
        this.hora = hora;

    }

    public void setMinuto(int minuto) {
        if (minuto < 0 || minuto > 59) {
            throw new IllegalArgumentException("Minuto inválido");
        }
        this.minuto = minuto;
    }

    public void setSegundo(int segundo) {
        if (segundo < 0 || segundo > 59) {
            throw new IllegalArgumentException("Minuto inválido");
        }
        this.segundo = segundo;
    }

    /**
     * A Anatomia do %02d
     * O segredo está nesse pequeno código de formatação. Vamos quebrá-lo:
     * %: Indica que um valor será inserido aqui.
     * 0: O caractere de preenchimento. Se o número for pequeno, ele preenche com
     * zero.
     * 2: A largura mínima. Diz que o número deve ocupar pelo menos 2 espaços.
     * d: Indica que o valor é um número inteiro (decimal).
     */

    public String getHorarioFormatado(int hora, int minuto, int segundo) {
        return String.format("%02d:%02d:%02d", hora, minuto, segundo);
    }

    // método abstrato pedido no enunciado
    public abstract void copiarHorario(Relogio outroRelogio);

}
