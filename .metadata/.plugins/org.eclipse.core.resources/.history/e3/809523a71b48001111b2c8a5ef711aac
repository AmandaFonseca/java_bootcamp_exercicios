package com.amanda.curso.aula15;

import java.util.Iterator;
import java.util.Scanner;

public class JogoDaVelha {

	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);
		char jogadorAtual = 'X';
		boolean jogoAtivo = true;
		
		char[][] tabuleiro = {
	            {' ', ' ', ' '},
	            {' ', ' ', ' '},
	            {' ', ' ', ' '}
	        };
		
		while (jogoAtivo) {
            exibirTabuleiro(tabuleiro);
            System.out.println("Jogador " + jogadorAtual + ", escolha linha (0-2) e coluna (0-2): ");
            int linha = scanner.nextInt();
            int coluna = scanner.nextInt();

            if (linha >= 0 && linha < 3 && coluna >= 0 && coluna < 3 && tabuleiro[linha][coluna] == ' ') {
                tabuleiro[linha][coluna] = jogadorAtual;
                
                if (verificarVencedor(tabuleiro, jogadorAtual)) {
                    exibirTabuleiro(tabuleiro);
                    System.out.println("Jogador " + jogadorAtual + " venceu!");
                    jogoAtivo = false;
                } else if (tabuleiroLotado(tabuleiro)) {
                    exibirTabuleiro(tabuleiro);
                    System.out.println("Empate!");
                    jogoAtivo = false;
                } else {
                    jogadorAtual = (jogadorAtual == 'X') ? 'O' : 'X';
                }
            } else {
                System.out.println("Movimento inválido. Tente novamente.");
            }
        }
		
		scanner.close();

	}
	
	public static void exibirTabuleiro(char[][] tabuleiro) {
	    for (int i = 0; i < 3; i++) {
	        System.out.println(tabuleiro[i][0] + " | " + tabuleiro[i][1] + " | " + tabuleiro[i][2]);
	        if (i < 2) System.out.println("---------");
	    }
	}
	
	public static boolean verificarVencedor(char[][] t, char j) {
		 for (int i = 0; i < t.length; i++) {
			if(t[i][0] == j && t[i][1] == j && t[i][2] == j
					||t[0][i] == j && t[1][i] == j && t[2][i] == j) {
				return true;
			}
		}
		if(t[0][0] == j && t[1][1]== j && t[2][2]== j ||
					t[0][2] == j && t[1][1]== j && t[2][0]== j) {return true;}
		 return false;
		
	}
	
	public static boolean tabuleiroLotado(char[][] tabuleiro) {
        for (char[] linha : tabuleiro) {
            for (char espaco : linha) {
                if (espaco == ' ') return false;
            }
        }
        return true;
    }

}
